# ---- Server ----
# HTTP port the app binds. Railway injects PORT automatically for web
# services — do NOT override it there. Default when unset: 4000.
PORT=4000
# Bind address; must be 0.0.0.0 inside a container. Default: 0.0.0.0.
HOST=0.0.0.0
# SQLite database file path (relative to /app in the image). Default keeps the
# DB in ./data/ (ephemeral on Railway — lost on redeploy). If you attach a
# Railway volume, point DB_PATH at its mount, e.g. /data/ass-score.db.
DB_PATH=./data/ass-score.db

# ---- Public URLs ----
# Origin used in share links, result cards, and report emails. MUST be the
# public origin in production (https://ass-score.com) or whatever the public
# sees — never localhost. Default: https://ass-score.com.
PUBLIC_BASE_URL=https://ass-score.com

# ---- Email delivery (optional) ----
# Transport precedence: RESEND_API_KEY (preferred) -> SMTP_* -> no-op.
# A no-op logs "email not configured" and skips delivery; the scan still
# succeeds. Set either RESEND_API_KEY or all SMTP_* vars to enable.
# Resend: POST https://api.resend.com/emails (Authorization: Bearer key,
# JSON { from, to, subject, html }) via Node's global fetch — no SDK needed.
RESEND_API_KEY=
# Sender for Resend. MUST be (or sit behind) a domain verified with Resend,
# otherwise production sends are rejected. Falls back to SMTP_FROM, then to
# 'A.S.S. Score <onboarding@resend.dev>' (a warning is logged in that case).
RESEND_FROM='A.S.S. Score <no-reply@ass-score.com>'
# SMTP transport (used only when RESEND_API_KEY is unset/empty).
SMTP_HOST=
SMTP_PORT=587
# true when using port 465 (implicit TLS); otherwise false (STARTTLS on 587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM='A.S.S. Score <no-reply@ass-score.com>'
# Optional override of the report subject line.
EMAIL_SUBJECT=Your website audit is ready

# ---- Order fulfillment webhook (POST /api/v1/webhook) ----
# Per-IP daily cap on accepted order webhooks (Fiverr/Stripe/LemonSqueezy).
# 0 disables the cap. Default: 10.
MAX_WEBHOOKS_PER_DAY=10
# ---- Public scan API (POST /api/v1/scan) ----
# Per-IP daily cap on accepted scans (valid URL that passes the SSRF guard is
# accepted and counts; 400 validation failures never consume quota). Ledger is
# separate from MAX_WEBHOOKS_PER_DAY — the two caps never share counts.
# 0 disables the cap. Default: 3.
MAX_SCANS_PER_DAY=3